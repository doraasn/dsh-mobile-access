{
  "name": "dsh-mobile-access",
  "version": "0.1.0",
  "description": "DSH 移动访问：轻量反向代理 + 设备配对 + 移动页模块裁剪，隧道交给外部 cloudflared/cpolar",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doraasn/dsh-mobile-access.git"
  },
  "homepage": "https://github.com/doraasn/dsh-mobile-access#readme",
  "bugs": {
    "url": "https://github.com/doraasn/dsh-mobile-access/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
